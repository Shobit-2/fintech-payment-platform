// ============================================================================
// Jenkinsfile - Digital Payment Processing Platform CI/CD Pipeline
//
// STAGES IMPLEMENTED SO FAR: Checkout, Build & Test, SCA + SBOM, SonarQube,
// Docker Build, Trivy Scan, Push to ECR
// Later steps will add: EKS deploy, ArgoCD sync, DAST, smoke test,
// canary/blue-green.
//
// NOTE: Push to ECR currently authenticates via a static AWS credential
// ('aws-credentials' in Jenkins) rather than the EC2 instance's IAM role.
// This was a deliberate, temporary tradeoff to unblock the pipeline - the
// instance-role approach (see terraform/jenkins-ec2/ecr-push-policy.tf)
// is the more secure long-term target and should be revisited.
// ============================================================================

pipeline {
    agent any

    environment {
        JAVA_HOME  = '/usr/lib/jvm/java-21-openjdk-amd64'
        PATH       = "/usr/local/bin:${JAVA_HOME}/bin:${env.PATH}"
        AWS_REGION = 'us-east-1'

        // Image tag = build number + short commit SHA (e.g. "42-a1b2c3d").
        // Traceable and immutable - unlike 'latest', this tag is never
        // overwritten, essential for reliable rollback later.
        IMAGE_NAME = 'fintech-payment-platform'
        IMAGE_TAG  = "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
        ansiColor('xterm')
        timeout(time: 60, unit: 'MINUTES')
    }

    stages {

        // ====================================================================
        // STAGE 1: SOURCE CODE CHECKOUT
        // ====================================================================
        stage('Checkout') {
            steps {
                echo "Checked out branch: ${env.GIT_BRANCH}"
                echo "Commit: ${env.GIT_COMMIT}"
                sh 'ls -la application/'
            }
        }

        // ====================================================================
        // STAGE 2: BUILD + TEST (CI)
        // ====================================================================
        stage('Build & Test') {
            steps {
                dir('application') {
                    sh '''
                        echo "Using JDK:"
                        java -version
                        echo "Using Maven:"
                        mvn -version

                        mvn clean verify
                    '''
                }
            }
            post {
                always {
                    junit testResults: 'application/target/surefire-reports/*.xml,application/target/failsafe-reports/*.xml',
                          allowEmptyResults: true

                    archiveArtifacts artifacts: 'application/target/*.jar',
                                      allowEmptyArchive: true,
                                      fingerprint: true
                }
            }
        }

        // ====================================================================
        // STAGE 3: SOFTWARE COMPOSITION ANALYSIS + SBOM
        // ====================================================================
        stage('SCA + SBOM') {
            steps {
                dir('application') {
                    withCredentials([string(credentialsId: 'nvd-api-key', variable: 'NVD_API_KEY')]) {
                        sh '''
                            mvn org.owasp:dependency-check-maven:check -DnvdApiKey=$NVD_API_KEY
                            mvn org.cyclonedx:cyclonedx-maven-plugin:makeAggregateBom
                        '''
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'application/target/dependency-check-report.html,application/target/bom.xml',
                                      allowEmptyArchive: true,
                                      fingerprint: true
                }
            }
        }

        // ====================================================================
        // STAGE 4: SONARQUBE CLOUD STATIC ANALYSIS + QUALITY GATE
        // ====================================================================
        stage('SonarQube Analysis') {
            steps {
                dir('application') {
                    withCredentials([string(credentialsId: 'sonarcloud-token', variable: 'SONAR_TOKEN')]) {
                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                                -Dsonar.organization=shobit-2 \
                                -Dsonar.projectKey=shobit-2_fintech-payment-platform \
                                -Dsonar.host.url=https://sonarcloud.io \
                                -Dsonar.token=$SONAR_TOKEN \
                                -Dsonar.qualitygate.wait=true
                        '''
                    }
                }
            }
        }

        // ====================================================================
        // STAGE 5: DOCKER BUILD
        // ====================================================================
        stage('Docker Build') {
            steps {
                dir('application') {
                    sh '''
                        docker build -t $IMAGE_NAME:$IMAGE_TAG -t $IMAGE_NAME:latest .
                        echo "Built image:"
                        docker images $IMAGE_NAME
                    '''
                }
            }
        }

        // ====================================================================
        // STAGE 6: TRIVY CONTAINER SECURITY SCAN
        // ====================================================================
        stage('Trivy Scan') {
            steps {
                dir('application') {
                    sh '''
                        trivy image --skip-version-check --format table $IMAGE_NAME:$IMAGE_TAG

                        trivy image --skip-version-check --format json --output trivy-report.json $IMAGE_NAME:$IMAGE_TAG

                        trivy image --skip-version-check --exit-code 1 --severity CRITICAL $IMAGE_NAME:$IMAGE_TAG
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'application/trivy-report.json',
                                      allowEmptyArchive: true,
                                      fingerprint: true
                }
            }
        }

        // ====================================================================
        // STAGE 7: PUSH TO AMAZON ECR
        // Authenticates via a static AWS credential (see NOTE at top of
        // file re: revisiting instance-role auth later).
        // ====================================================================
        stage('Push to ECR') {
            steps {
                dir('application') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: 'aws-credentials']
                    ]) {
                        sh '''
                            set -eu

                            AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
                            ECR_REPO="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/fintech-payment-platform"

                            echo "AWS Account: ${AWS_ACCOUNT_ID}"
                            echo "Logging into ECR..."

                            aws ecr get-login-password --region ${AWS_REGION} | \
                                docker login \
                                --username AWS \
                                --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                            docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${ECR_REPO}:${IMAGE_TAG}

                            docker push ${ECR_REPO}:${IMAGE_TAG}

                            echo "Successfully pushed ${ECR_REPO}:${IMAGE_TAG}"
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
            sh 'docker image prune -f || true'
        }
        success {
            echo "✅ Build & Test stage passed."
        }
        failure {
            echo "❌ Pipeline failed - check the stage logs above for details."
        }
    }
}